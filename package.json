{
  "name": "troubadix-mix",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:nextcloud": "svelte-kit sync && vite build --config vite.nextcloud.config.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/adapter-cloudflare": "^5.0.1",
    "@sveltejs/kit": "^2.15.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.18.0",
    "svelte-check": "^3.8.6",
    "tailwindcss": "^3.4.17",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "type": "module",
  "dependencies": {
    "@nextcloud/files": "3.12.2",
    "@nextcloud/l10n": "3.4.1",
    "@nextcloud/router": "3.2.0",
    "svelte-pdfjs": "^0.9.0"
  },
  "overrides": {
    "svelte-pdfjs": {
      "svelte": "$svelte"
    }
  }
}
